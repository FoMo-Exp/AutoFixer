{
  "openapi": "3.1.0",
  "info": {
    "title": "ForgePilot orchestrator API",
    "version": "0.2.0",
    "description": "forgepilot-api/v1: the Node-to-UI contract of the ForgePilot pilot. The UI calls Node only, at an ephemeral loopback address; it never sees dsh sockets, boot tokens, Pi credentials, raw tool output, or provider credentials. Generated from the orchestrator implementation; shapes are defined by docs/contracts/forgepilot-api-v1.md."
  },
  "servers": [
    {
      "url": "http://127.0.0.1",
      "description": "Ephemeral loopback bind"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/tasks": {
      "post": {
        "operationId": "createTask",
        "summary": "Create a remediation task",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 256
            },
            "description": "Replay-safe create. Repeating the request with the same key and payload returns the original task instead of minting a second run; the same key with a different payload is 409 IDEMPOTENCY_CONFLICT."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "repository_id",
                  "base_ref",
                  "summary"
                ],
                "properties": {
                  "repository_id": {
                    "type": "string",
                    "examples": [
                      "github:Luthiel/AutoFixer"
                    ]
                  },
                  "base_ref": {
                    "type": "string",
                    "examples": [
                      "main"
                    ]
                  },
                  "summary": {
                    "type": "string"
                  },
                  "source_reference": {
                    "type": "string"
                  },
                  "acceptance_criteria": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Authorization: Bearer <token> header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Task state conflict or IDEMPOTENCY_CONFLICT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Prohibited work was rejected by dsh (details.task_id names the rejected task)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "PI_UNAVAILABLE or DSH_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "get": {
        "operationId": "listTasks",
        "summary": "List tasks",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "queued",
                "assessing_risk",
                "awaiting_approval",
                "approved",
                "planning",
                "executing",
                "validating",
                "awaiting_review",
                "approved_for_merge",
                "stopped",
                "rejected",
                "cancelled",
                "timed_out",
                "expired",
                "merged"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "next_cursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Task"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid cursor or status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Authorization: Bearer <token> header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/tasks/{task_id}": {
      "get": {
        "operationId": "getTask",
        "summary": "Read one task",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Authorization: Bearer <token> header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/tasks/{task_id}/runs": {
      "get": {
        "operationId": "getTaskRuns",
        "summary": "List the task's runs, ordered by creation time",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Run summaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RunSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Authorization: Bearer <token> header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/tasks/{task_id}/messages": {
      "post": {
        "operationId": "sendMessage",
        "summary": "Queue a steering or follow-up message for the task's Pi session",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "mode",
                  "content"
                ],
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "steer",
                      "follow_up"
                    ]
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Message queued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "task_id",
                    "queued"
                  ],
                  "properties": {
                    "task_id": {
                      "type": "string"
                    },
                    "queued": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Authorization: Bearer <token> header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Task state conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/tasks/{task_id}/approvals": {
      "post": {
        "operationId": "approveTask",
        "summary": "Record the pre-grant approval decision for an elevated task",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "decision",
                  "scope_digest"
                ],
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "approve",
                      "reject"
                    ]
                  },
                  "scope_digest": {
                    "type": "string",
                    "examples": [
                      "sha256:…"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task after the decision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Authorization: Bearer <token> header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN or a dsh policy denial",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Task state conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "PI_UNAVAILABLE or DSH_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/tasks/{task_id}/cancel": {
      "post": {
        "operationId": "cancelTask",
        "summary": "Cancel a task",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Cancellation requested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Authorization: Bearer <token> header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The task cannot be cancelled in its terminal state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/tasks/{task_id}/timeline": {
      "get": {
        "operationId": "getTaskTimeline",
        "summary": "Read the task's redacted event timeline",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Timeline items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TaskEvent"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Authorization: Bearer <token> header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/tasks/{task_id}/artifacts/{artifact_id}": {
      "get": {
        "operationId": "getTaskArtifact",
        "summary": "Read one redacted artifact for the task's current run",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "artifact_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted artifact, already redacted by dsh",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Authorization: Bearer <token> header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Artifact access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Task or artifact not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Artifact not finalized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Artifact expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/tasks/{task_id}/stream": {
      "get": {
        "operationId": "streamTaskEvents",
        "summary": "SSE stream of task events; replays by Last-Event-ID in sequence order from the durable projection, so a reconnect after an orchestrator restart resumes exactly where the client stopped without duplicating business events. A terminal task's stream always closes after its replay, including when Last-Event-ID is already anchored at task.terminal and the replay has nothing left to write.",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Replay events after this event_id; unknown ids replay from the start."
          }
        ],
        "responses": {
          "200": {
            "description": "text/event-stream. Each event carries id (event_id), the event type, and data: the TaskEvent envelope. The stream ends after task.terminal.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/TaskEvent"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Authorization: Bearer <token> header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "required": [
          "id",
          "version",
          "created_at",
          "updated_at",
          "current_run_id",
          "run_history_url",
          "repository",
          "request",
          "association",
          "revision",
          "status",
          "status_reason",
          "risk",
          "progress",
          "governance",
          "artifacts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "current_run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "run_history_url": {
            "type": "string"
          },
          "repository": {
            "type": "object",
            "required": [
              "id",
              "display_name",
              "base_ref",
              "base_sha"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              },
              "base_ref": {
                "type": "string"
              },
              "base_sha": {
                "type": "string"
              }
            }
          },
          "request": {
            "type": "object",
            "required": [
              "summary",
              "source_reference"
            ],
            "properties": {
              "summary": {
                "type": "string"
              },
              "source_reference": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "association": {
            "type": "object",
            "description": "Verifiable task/run/repository/revision binding. run_id and head_sha are projected from the authoritative dsh run; task_id, repository_id, and base_sha are the creation bindings dsh accepted and pinned for the run. Node never invents any of these values.",
            "required": [
              "task_id",
              "run_id",
              "repository_id",
              "base_sha",
              "head_sha"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "run_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "repository_id": {
                "type": "string"
              },
              "base_sha": {
                "type": "string"
              },
              "head_sha": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "revision": {
            "type": "object",
            "required": [
              "base_sha",
              "head_sha"
            ],
            "properties": {
              "base_sha": {
                "type": "string"
              },
              "head_sha": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "assessing_risk",
              "awaiting_approval",
              "approved",
              "planning",
              "executing",
              "validating",
              "awaiting_review",
              "approved_for_merge",
              "stopped",
              "rejected",
              "cancelled",
              "timed_out",
              "expired",
              "merged"
            ]
          },
          "status_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "risk": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "class",
              "decision_code",
              "requires_human_approval"
            ],
            "properties": {
              "class": {
                "type": "string",
                "enum": [
                  "low",
                  "elevated",
                  "prohibited"
                ]
              },
              "decision_code": {
                "type": "string"
              },
              "requires_human_approval": {
                "type": "boolean"
              }
            }
          },
          "progress": {
            "type": "object",
            "required": [
              "phase",
              "actions_completed",
              "actions_total"
            ],
            "properties": {
              "phase": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "actions_completed": {
                "type": "integer"
              },
              "actions_total": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          "governance": {
            "type": "object",
            "description": "GitHub merge-boundary projection for the current head. Approvals and checks observed against an older head are invalidated: observations_valid turns false and merge_queue_eligible turns false until dsh observes them against the current head.",
            "required": [
              "current_head_sha",
              "observations_valid",
              "merge_queue_eligible"
            ],
            "properties": {
              "current_head_sha": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "observations_valid": {
                "type": "boolean"
              },
              "merge_queue_eligible": {
                "type": "boolean"
              }
            }
          },
          "artifacts": {
            "type": "object",
            "required": [
              "patch",
              "report",
              "evidence_bundle_available",
              "index"
            ],
            "properties": {
              "patch": {
                "type": "null"
              },
              "report": {
                "type": "null"
              },
              "evidence_bundle_available": {
                "type": "boolean"
              },
              "index": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ArtifactMetadata"
                }
              }
            }
          }
        }
      },
      "TaskEvent": {
        "type": "object",
        "required": [
          "event_id",
          "sequence",
          "occurred_at",
          "task_id",
          "task_version",
          "type",
          "data"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "sequence": {
            "type": "integer"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "task_id": {
            "type": "string"
          },
          "task_version": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "task.status_changed",
              "pi.text_delta",
              "pi.turn_settled",
              "plan.updated",
              "approval.required",
              "approval.resolved",
              "tool.requested",
              "tool.completed",
              "tool.denied",
              "validation.completed",
              "artifact.available",
              "evidence.appended",
              "task.terminal"
            ]
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "RunSummary": {
        "type": "object",
        "required": [
          "run_id",
          "state",
          "created_at"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "requested",
              "approved",
              "running",
              "awaiting_review",
              "approved_for_merge",
              "stopped",
              "timed_out",
              "expired",
              "rejected",
              "cancelled",
              "merged"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ArtifactMetadata": {
        "type": "object",
        "required": [
          "artifact_id",
          "available",
          "digest",
          "head_sha"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "examples": [
              "evidence_bundle",
              "patch_report"
            ]
          },
          "available": {
            "type": "boolean"
          },
          "digest": {
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "sha256:…"
            ]
          },
          "head_sha": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id",
              "retryable",
              "details"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-process API bearer token, minted at orchestrator start and written 0600 to the API token file. The UI reads that file and sends it as Authorization: Bearer <token> on every request; possession of the token authorizes acting as the local operator, approvals included."
      }
    }
  }
}
